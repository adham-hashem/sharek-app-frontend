EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Use a LAN HTTPS URL on a physical device; localhost only works in the web emulator.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Public frontend URL used by Supabase email/OAuth redirects in production.
EXPO_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
# Enable only after the matching provider and callback URLs are configured in Supabase.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_FACEBOOK_AUTH_ENABLED=false
